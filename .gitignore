# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
*.local
!.env.example
!.streamlit/secrets.toml.example

# Model weights & large binaries. The reviewed attribute classifiers are the
# only exceptions; standard YOLO weights are downloaded on demand.
models/*
*.pt
*.pth
*.onnx
*.engine
*.weights
!models/queue_classifier.pt
!models/seated_classifier.pt

# Generated detection outputs (data/samples/ inputs ARE tracked).
# Contents ignored rather than the directory, so .gitkeep survives.
data/outputs/*
!data/outputs/.gitkeep

# Developer-local photo samples for the Streamlit upload workflow.
data/samples/local/

# Logs & runtime artifacts
*.log
runs/

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local dashboard secrets (the example remains tracked above).
.streamlit/secrets.toml

# Docs / large PDFs (uncomment if you don't want to track these)
# *.pdf


# Raw drops from teammates, staged before promotion into the package.
# See docs/INTEGRATION.md.
incoming/*
!incoming/.gitkeep

# Legacy prototype folder, superseded by the inference/ package.
Human_detection/

# Training handover: raw crops and source photos stay local. The reviewed
# production checkpoints are promoted into models/ above.
content/

# Local real-world evaluation photos and annotations.
drive-download-*/
dataset_labels.json
