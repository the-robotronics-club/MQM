FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app \
    DASHBOARD_SNAPSHOT_ONLY=true
WORKDIR /app
COPY requirements-free-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements-free-dashboard.txt
COPY dashboard ./dashboard
COPY .streamlit/config.toml ./.streamlit/config.toml
RUN useradd --uid 10001 --create-home app && chown -R app:app /app
USER app
EXPOSE 10000
CMD ["python", "-m", "streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=10000", "--server.headless=true", "--browser.gatherUsageStats=false"]
