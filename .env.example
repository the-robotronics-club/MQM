# Copy to .env and replace every `change-me` value. Never commit .env.

# Camera authentication and configuration
CAMERA_API_KEY=change-me-to-a-long-random-value
KNOWN_CAMERAS=mess_main
FRAME_METRICS_MODE=distance
# distance accepts arbitrary snapshot dimensions and uses the tested photo pipeline.
# calibrated requires zones traced against the mounted camera view and resolution.
MAX_UPLOAD_BYTES=10485760

# Redis latest-reading cache (local Docker default shown)
REDIS_URL=redis://localhost:6379/0
LATEST_TTL_SECONDS=30
READ_CACHE_TTL_SECONDS=5

# InfluxDB 2.x / Cloud connection (local Docker values shown)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me-to-a-long-random-value
INFLUX_ORG=mess-monitor
INFLUX_BUCKET=camera-metrics

# Used only by Docker Compose to initialize the local InfluxDB container
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change-me-to-a-long-random-value

# Dashboard and browser access
READ_API_BASE_URL=http://localhost:8000
DASHBOARD_DEFAULT_MODE=Live cameras
CORS_ALLOW_ORIGINS=http://localhost:8501

# Optional detector overrides. Defaults match inference/model.py.
MODEL_WEIGHTS=yolov8n.pt
MODEL_CONFIDENCE=0.25
MODEL_IOU=0.5
MODEL_IMAGE_SIZE=1280

# Reviewed person-crop classifiers. Set false only while diagnosing or retraining.
ATTRIBUTE_CLASSIFIERS_ENABLED=true
QUEUE_CLASSIFIER_WEIGHTS=queue_classifier.pt
SEATED_CLASSIFIER_WEIGHTS=seated_classifier.pt

# Queue estimator strategy. Production preserves the deployed polygon + MobileNetV2 baseline.
QUEUE_ESTIMATOR=production
# Research modes need a validated research/configs/cameras/<camera_id>.yaml.
# RESEARCH_MEMBERSHIP_METHOD=logistic
# RESEARCH_MEMBERSHIP_MODEL=models/membership.joblib
# RESEARCH_ALLOW_GEOMETRIC_FALLBACK=true
# RESEARCH_OCCLUSION_METHOD=spacing
# RESEARCH_REFERENCE_POINT=bottom_center
# RESEARCH_EXPECTED_SPACING=0.75
# RESEARCH_SPACING_MODEL=models/research/spacing.json
# RESEARCH_RESIDUAL_MODEL=models/occlusion.joblib
# RESEARCH_MAX_HIDDEN_CORRECTION=5
# RESEARCH_UNCERTAINTY_DELTA=1.0
# RESEARCH_UNCERTAINTY_MODEL=models/research/uncertainty.json

# Retain lower-confidence people only when at least 25 crowd candidates exist.
MODEL_ADAPTIVE_CONFIDENCE=true
MODEL_CROWD_CONFIDENCE=0.15
MODEL_CROWD_MIN_PEOPLE=25
# Optional screenshot padding crop; validate posture/queue tradeoffs before enabling.
MODEL_TRIM_BLACK_PADDING=false
